# Copy to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development
APP_BASE_URL=http://localhost:5173
SECRET_KEY=change-me-with-a-long-random-string

# First admin, created at startup if no admin exists
ADMIN_EMAIL=admin@example.com
# Optional: lets the first admin log in with a password right away (used only if the admin has none)
ADMIN_PASSWORD=

# Local SQL Server (docker-compose)
MSSQL_SA_PASSWORD=Change-me-123!
DATABASE_URL=mssql+pyodbc://sa:Change-me-123!@localhost:1433/cissonauti?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Email: "console" in development, "acs" (Azure Communication Services) in production
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
ACS_CONNECTION_STRING=
